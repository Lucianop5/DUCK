# ─────────────────────────────────────────────────────────────
# Gastos Hormiga — variables de entorno
# Copiar a .env y completar. NUNCA commitear .env.
# ─────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL en Docker, publicado en :5433)
POSTGRES_DB=gastos_hormiga
POSTGRES_USER=gastos_hormiga
POSTGRES_PASSWORD=cambia-esta-password
DATABASE_URL="postgresql://gastos_hormiga:cambia-esta-password@localhost:5433/gastos_hormiga?schema=public"

# Better Auth
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=cambia-este-secreto-por-uno-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
