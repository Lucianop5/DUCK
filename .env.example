# ─────────────────────────────────────────────────────────────
# Gastos Hormiga — variables de entorno
# Copiar a .env y completar. NUNCA commitear .env.
# ─────────────────────────────────────────────────────────────

# Base de datos (MySQL 8.4 en Docker, publicado en :3307 para convivir con
# el MySQL local del sistema en :3306).
MYSQL_DATABASE=gastos_hormiga
MYSQL_USER=gastos_hormiga
MYSQL_PASSWORD=cambia-esta-password
MYSQL_ROOT_PASSWORD=cambia-esta-root-password
MYSQL_PORT=3307
DATABASE_URL="mysql://gastos_hormiga:cambia-esta-password@127.0.0.1:3307/gastos_hormiga"

# Better Auth
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=cambia-este-secreto-por-uno-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
